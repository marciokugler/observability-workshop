{
  "name": "ciscolive26-demo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "terraform:webhook-plan": "bash -lc 'set -a && source .env && set +a && terraform -chdir=infra/terraform plan -input=false -target=signalfx_detector.claims_knowledge_filesystem_pressure -target=signalfx_detector.claims_knowledge_latency -target=signalfx_detector.claims_knowledge_error_rate -var=\"splunk_access_token=$SPLUNK_ACCESS_TOKEN\" -var=\"splunk_realm=${SPLUNK_REALM:-us1}\" -var=\"deployment_environment=${DEPLOYMENT_ENVIRONMENT:-demo}\" -var=\"instance=${INSTANCE:-student-001}\" -var=\"cache_mountpoint=${SPLUNK_CACHE_MOUNTPOINT:-/var/cache/claims-knowledge}\" -var=\"cache_utilization_metric=${SPLUNK_CACHE_UTILIZATION_METRIC:-${CLAIMS_KNOWLEDGE_CACHE_UTILIZATION_METRIC:-claims_knowledge.cache.utilization}}\" -var=\"claim_status_latency_metric=${SPLUNK_CLAIM_STATUS_LATENCY_METRIC:-${CLAIMS_KNOWLEDGE_CLAIM_STATUS_LATENCY_METRIC:-claims_knowledge.claim_status.latency_ms}}\" -var=\"orchestrator_webhook_url=$ORCHESTRATOR_PUBLIC_WEBHOOK_URL\" -var=\"existing_webhook_credential_id=$SPLUNK_EXISTING_WEBHOOK_CREDENTIAL_ID\" -var=\"enable_webhook_integration=false\"'",
    "terraform:webhook-apply": "bash -lc 'set -a && source .env && set +a && terraform -chdir=infra/terraform apply -input=false -auto-approve -target=signalfx_detector.claims_knowledge_filesystem_pressure -target=signalfx_detector.claims_knowledge_latency -target=signalfx_detector.claims_knowledge_error_rate -var=\"splunk_access_token=$SPLUNK_ACCESS_TOKEN\" -var=\"splunk_realm=${SPLUNK_REALM:-us1}\" -var=\"deployment_environment=${DEPLOYMENT_ENVIRONMENT:-demo}\" -var=\"instance=${INSTANCE:-student-001}\" -var=\"cache_mountpoint=${SPLUNK_CACHE_MOUNTPOINT:-/var/cache/claims-knowledge}\" -var=\"cache_utilization_metric=${SPLUNK_CACHE_UTILIZATION_METRIC:-${CLAIMS_KNOWLEDGE_CACHE_UTILIZATION_METRIC:-claims_knowledge.cache.utilization}}\" -var=\"claim_status_latency_metric=${SPLUNK_CLAIM_STATUS_LATENCY_METRIC:-${CLAIMS_KNOWLEDGE_CLAIM_STATUS_LATENCY_METRIC:-claims_knowledge.claim_status.latency_ms}}\" -var=\"orchestrator_webhook_url=$ORCHESTRATOR_PUBLIC_WEBHOOK_URL\" -var=\"existing_webhook_credential_id=$SPLUNK_EXISTING_WEBHOOK_CREDENTIAL_ID\" -var=\"enable_webhook_integration=false\"'",
    "simulate:traffic": "node scripts/traffic-simulator.mjs",
    "simulate:rum": "node scripts/rum-simulator.mjs",
    "test": "npm run test:ts",
    "test:ts": "tsx --test tests/unit/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "splunk:render": "python3 infra/splunk/sync_splunk_objects.py",
    "splunk:apply": "python3 infra/splunk/sync_splunk_objects.py --apply",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.2.1",
    "playwright": "^1.54.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@splunk/otel": "^4.4.0",
    "@splunk/otel-web": "^2.3.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.61.1",
    "@rollup/rollup-linux-x64-gnu": "4.61.1"
  }
}
